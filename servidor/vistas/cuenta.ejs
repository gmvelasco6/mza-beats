<%# "Mi cuenta": la foto de perfil, los datos y la contraseña del usuario logueado. %><%- include('partes/head') %>
<body>
    <%- include('partes/barra_panel') %>
    <main class="lienzo">
        <div class="fila-titulo">
            <img class="avatar avatar-grande" data-avatar-vista src="<%= rutaAvatar(usuario) %>" alt="Tu foto de perfil" width="72" height="72">
            <div>
                <h1><%= usuario.nombre %></h1>
                <p class="bajada">@<%= usuario.usuario %> · <%= rol %> · <span class="num"><%= usuario.cantidad_creaciones %></span> <%= usuario.cantidad_creaciones === 1 ? 'creación disponible' : 'creaciones disponibles' %></p>
            </div>
            <% if (puedeAgregar) { %>
                <a class="boton boton-principal fila-titulo-accion" href="/agregar-banda">Agregar banda</a>
            <% } %>
        </div>

        <%- include('partes/mensajes') %>

        <section class="ajuste" aria-labelledby="titulo-foto">
            <div class="ajuste-texto">
                <h2 id="titulo-foto">Foto de perfil</h2>
                <p>Elegí un dibujo. Aparece en el menú cuando entrás a MzaBeats.</p>
            </div>
            <form class="tarjeta" method="post" action="/cuenta/foto">
                <%- include('partes/csrf') %>
                <fieldset class="avatares">
                    <legend class="solo-lectores">Dibujos disponibles</legend>
                    <label class="avatar-opcion">
                        <input type="radio" name="avatar" value="" data-avatar-ruta="/images/inicio/usuario.png"<% if (!usuario.avatar) { %> checked<% } %>>
                        <img src="/images/inicio/usuario.png" alt="" width="72" height="72" loading="lazy">
                        <span>Sin dibujo</span>
                    </label>
                    <% for (const { clave, nombre } of avatares) { %>
                        <label class="avatar-opcion">
                            <input type="radio" name="avatar" value="<%= clave %>" data-avatar-ruta="/images/avatares/<%= clave %>.svg"<% if (usuario.avatar === clave) { %> checked<% } %>>
                            <img src="/images/avatares/<%= clave %>.svg" alt="" width="72" height="72" loading="lazy">
                            <span><%= nombre %></span>
                        </label>
                    <% } %>
                </fieldset>
                <div class="tarjeta-pie">
                    <button type="submit" class="boton boton-principal">Guardar foto</button>
                </div>
            </form>
        </section>

        <section class="ajuste" aria-labelledby="titulo-datos">
            <div class="ajuste-texto">
                <h2 id="titulo-datos">Tus datos</h2>
                <p>Tu usuario es el que usás para entrar y el que ven los demás.</p>
            </div>
            <form class="tarjeta" id="form-cuenta" method="POST">
                <%- include('partes/csrf') %>
                <label class="campo">
                    <span>Nombre</span>
                    <input type="text" name="nombre" value="<%= nombreMostrado %>" maxlength="<%= limites.nombreMaximo %>" autocomplete="name">
                </label>
                <label class="campo">
                    <span>Usuario</span>
                    <input type="text" name="usuario" value="<%= usuarioMostrado %>" maxlength="<%= limites.usuarioMaximo %>" autocomplete="username">
                </label>
                <div class="tarjeta-pie">
                    <button type="submit" name="actualizar" class="boton boton-principal">Guardar datos</button>
                </div>
            </form>
        </section>

        <section class="ajuste" aria-labelledby="titulo-clave">
            <div class="ajuste-texto">
                <h2 id="titulo-clave">Contraseña</h2>
                <p>Te vamos a pedir la actual antes de cambiarla.</p>
            </div>
            <div class="tarjeta tarjeta-fila">
                <p>Tiene que tener al menos <%= limites.claveMinimo %> caracteres.</p>
                <a class="boton boton-secundario cambiar-contraseña" href="/cuenta/clave">Cambiar contraseña</a>
            </div>
        </section>

        <section class="ajuste" aria-labelledby="titulo-mis-datos">
            <div class="ajuste-texto">
                <h2 id="titulo-mis-datos">Tus datos guardados</h2>
                <p>Bajá un archivo con todo lo que MzaBeats guarda de tu cuenta. Más detalles en la <a href="/privacidad">política de privacidad</a>.</p>
            </div>
            <div class="tarjeta tarjeta-fila">
                <p>Un archivo JSON, que se abre con cualquier editor de texto.</p>
                <a class="boton boton-secundario" href="/cuenta/datos" download>Descargar mis datos</a>
            </div>
        </section>

        <section class="ajuste" aria-labelledby="titulo-sesion">
            <div class="ajuste-texto">
                <h2 id="titulo-sesion">Sesión</h2>
                <p>Cerrala si estás usando una computadora que no es tuya.</p>
            </div>
            <form class="tarjeta tarjeta-fila" method="post" action="/salir">
                <%- include('partes/csrf') %>
                <p>Conectado como <strong>@<%= usuario.usuario %></strong></p>
                <button type="submit" class="boton boton-secundario">Cerrar sesión</button>
            </form>
        </section>

        <section class="ajuste ajuste-peligro" id="eliminar" aria-labelledby="titulo-eliminar">
            <div class="ajuste-texto">
                <h2 id="titulo-eliminar">Eliminar la cuenta</h2>
                <p>Se borran tu cuenta y sus datos en el momento. No se puede deshacer. Las bandas que cargaste siguen en el sitio.</p>
            </div>
            <form class="tarjeta" method="post" action="/cuenta/eliminar">
                <%- include('partes/csrf') %>
                <label class="campo">
                    <span>Tu contraseña actual</span>
                    <input type="password" name="clave-actual" autocomplete="current-password" required>
                </label>
                <div class="tarjeta-pie">
                    <button type="submit" class="boton boton-peligro">Eliminar mi cuenta</button>
                </div>
            </form>
        </section>
    </main>
    <%- include('partes/pie') %>
</body>
</html>
