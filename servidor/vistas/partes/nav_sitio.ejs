<%#
  Menú principal (inicio y páginas de géneros).
  conSobreNosotros  Muestra el enlace "Sobre Nosotros" (sólo existe en el inicio)
%>
<nav>
    <div class="logo-container">
        <img class="logo" src="/images/logo/logoMzaBeats.png" alt="MzaBeats">
    </div>

    <!-- Checkbox e icono hamburguesa fuera del container -->
    <input type="checkbox" class="btn-nav" id="btn-nav">
    <label for="btn-nav" class="menu-icon">&#9776;</label>

    <div class="nav-container">
        <ul class="nav-list">
            <li class="nav-list-item"><a href="/">Inicio</a></li>
            <li class="linea">|</li>
            <li class="nav-list-item-genero">
                <input type="checkbox" id="btn-genero" class="btn-genero">
                <label for="btn-genero" class="genero-label">Género</label>
                <ul class="genero-list">
                    <% for (const [clave, genero] of Object.entries(generos)) { %>
                        <li class="genero-list-item"><a href="/generos/<%= clave %>"><%= genero.nombre %></a></li>
                    <% } %>
                </ul>
            </li>
            <% if (locals.conSobreNosotros) { %>
                <li class="linea">|</li>
                <li><a href="#about-us">Sobre Nosotros</a></li>
            <% } %>
            <% if (esAdmin) { %>
                <li class="linea">|</li>
                <li><a href="/admin">Administrar</a></li>
            <% } %>
            <% if (usuario) { %>
                <li class="linea">|</li>
                <li><a href="/cuenta">Ver Cuenta</a></li>
            <% } %>
        </ul>

        <!-- Bloque de usuario dentro del desplegable móvil -->
        <div class="user-container-mobile">
            <%- include('bloque_usuario') %>
        </div>
    </div>

    <!-- Bloque de usuario para escritorio -->
    <div class="user-container">
        <%- include('bloque_usuario') %>
    </div>
</nav>
