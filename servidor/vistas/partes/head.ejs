<%#
  Comienzo de cada página: doctype, <head>, estilos y scripts.
  titulo        Texto de la pestaña del navegador
  hojaDeEstilo  Nombre del CSS de la página (style, genero-style o php-style)
  descripcion   Resumen para buscadores y vistas previas (opcional)
  precargar     Imagen principal de la página, para pedirla antes que el resto (opcional)
  sinIndexar    true en páginas que no tienen que aparecer en buscadores (opcional)

  recurso() agrega a cada dirección la huella de su contenido, así el
  navegador guarda los archivos un año y aun así ve los cambios al instante.
%><!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= locals.descripcion || 'MzaBeats reúne a las bandas y artistas de Mendoza, Argentina: indie, pop y rock.' %>">
    <% if (locals.sinIndexar) { %><meta name="robots" content="noindex"><% } %>
    <% if (locals.precargar) { %><link rel="preload" href="<%= precargar %>" as="image" fetchpriority="high"><% } %>
    <link rel="stylesheet" href="<%= recurso(`/css/${hojaDeEstilo}.css`) %>">
    <link rel="stylesheet" href="<%= recurso('/css/comun.css') %>">
    <link rel="stylesheet" href="<%= recurso('/css/animaciones.css') %>">
    <link rel="stylesheet" href="<%= recurso('/css/celular.css') %>">
    <link rel="shortcut icon" href="/images/logo/page-icon.png" type="image/x-icon">
    <title><%= titulo %></title>
    <!-- Sin esto, las animaciones quedan en cola detrás de las fotos y la página tarda en aparecer -->
    <link rel="preload" href="<%= recurso('/vendor/gsap/gsap.min.js') %>" as="script">
    <link rel="preload" href="<%= recurso('/vendor/gsap/ScrollTrigger.min.js') %>" as="script">
    <link rel="preload" href="<%= recurso('/js/animaciones.js') %>" as="script">
    <script src="<%= recurso('/js/previo.js') %>"></script>
    <script defer src="<%= recurso('/vendor/gsap/gsap.min.js') %>"></script>
    <script defer src="<%= recurso('/vendor/gsap/ScrollTrigger.min.js') %>"></script>
    <script defer src="<%= recurso('/js/sitio.js') %>"></script>
    <script defer src="<%= recurso('/js/animaciones.js') %>"></script>
    <% if (umamiId) { %>
        <!-- Estadísticas de visitas (Umami). Sólo se activa si está configurado UMAMI_WEBSITE_ID -->
        <script defer src="<%= umamiScript %>" data-website-id="<%= umamiId %>"></script>
    <% } %>
</head>
