<%# Inicio de sesión. %><%- include('partes/head') %>
<body>
    <%- include('partes/nav_simple') %>
    <div class="formulario-container">
        <form class="formulario" align="center" method="post" data-revelar="abajo">
            <%- include('partes/csrf') %>
            <h1 align="center">Iniciar Sesión</h1>

            <%- include('partes/mensajes') %>

            <label class="etiqueta" for="user">Usuario</label>
            <input type="text" id="user" class="input" name="user" value="<%= valorUsuario %>" autocomplete="username">
            <label class="etiqueta" for="password">Contraseña</label>
            <input type="password" id="password" class="input" name="password" autocomplete="current-password">
            <p>¿No has creado un usuario? <a href="/registro">Regístrate</a></p>
            <input type="submit" name="btn-iniciar" class="btn" value="Iniciar Sesion">
        </form>
    </div>
    <%- include('partes/pie') %>
</body>
</html>
