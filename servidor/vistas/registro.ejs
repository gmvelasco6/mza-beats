<%# Registro de usuarios nuevos. %><%- include('partes/head') %>
<body>
    <%- include('partes/nav_simple') %>
    <div class="formulario-container">
        <form class="formulario" method="post" data-revelar="abajo">
            <%- include('partes/csrf') %>
            <h1>Registrarse</h1>

            <%- include('partes/mensajes') %>

            <label class="etiqueta" for="name">Nombre</label>
            <input type="text" id="name" class="input" name="name" value="<%= valores.nombre %>" maxlength="<%= limites.nombreMaximo %>">
            <label class="etiqueta" for="user">Usuario</label>
            <input type="text" id="user" class="input" name="user" value="<%= valores.usuario %>" maxlength="<%= limites.usuarioMaximo %>" autocomplete="username">
            <label class="etiqueta" for="password">Contraseña</label>
            <input type="password" id="password" class="input" name="password" minlength="<%= limites.claveMinimo %>" autocomplete="new-password">
            <label class="etiqueta" for="password-confirm">Repetir contraseña</label>
            <input type="password" id="password-confirm" class="input" name="password-confirm" minlength="<%= limites.claveMinimo %>" autocomplete="new-password">
            <%# Sin marcar: aceptar tiene que ser algo que la persona hace, no algo que ya viene hecho %>
            <label class="aceptar" for="acepto">
                <input type="checkbox" id="acepto" name="acepto" value="si" required>
                <span>Leí y acepto los <a href="/terminos" target="_blank" rel="noopener">términos</a>
                    y la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>.</span>
            </label>
            <p>¿Ya tienes un usuario? <a href="/login">Inicia Sesión</a></p>
            <input type="submit" name="btn-registro" class="btn" value="Registrarme">
        </form>
    </div>
    <%- include('partes/pie') %>
</body>
</html>
