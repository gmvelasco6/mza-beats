<%- include('partes/head') %>
<body>
    <header>
        <%- include('partes/nav_sitio', { conSobreNosotros: true }) %>
    </header>
    <main>
        <div class="intro">
            <h1 data-revelar="portada">Bienvenido a MzaBeats</h1>
            <h3 data-revelar="portada">Mendoza no solo es la tierra del buen vino, sino también, de la buena música.
                <br>En MzaBeats encontrarás tu próxima banda favorita.</h3>
        </div>

        <% Object.entries(generos).forEach(([clave, genero], posicion) => { %>
            <% if (posicion > 0) { %><hr><% } %>
            <section class="<%= clave %>-container" data-parallax>
                <img src="/<%= genero.imagenInicio %>" alt="imagen_<%= genero.nombre %>" class="<%= clave %>-img"
                    data-revelar="<%= posicion % 2 === 0 ? 'izquierda' : 'derecha' %>">
                <div class="<%= clave %>-description" data-revelar="<%= posicion % 2 === 0 ? 'derecha' : 'izquierda' %>">
                    <h2>Sección <%= genero.nombre %></h2>
                    <p><%= genero.intro %></p>
                </div>
            </section>
        <% }) %>

        <section id="about-us" class="about-us" data-revelar="abajo">
            <h2>¿Qué es MzaBeats?</h2>
            <p>MzaBeats es una página web que almacena todas las bandas de la provincia de Mendoza, Argentina.
                Nuestra idea es que la cultura musical mendocina sea más reconocida en todo el mundo.
            </p>
            <h2>¿Cómo aparezco en la página?</h2>
            <p>Si sos una banda o un artista mendocino, solo tenés que completar el
                formulario de consulta con tu nombre, mail y razón de participar,
                y nos pondremos en contacto lo más rápido posible.</p>
        </section>
    </main>
    <footer>
        <% if (mostrarParticipar) { %>
            <a class="btn-participar" href="/formulario">¡Quiero aparecer!</a>
        <% } %>
        <% if (puedeAgregar) { %>
            <a class="btn-agregar" href="/agregar-banda">Agregar banda</a>
        <% } %>
        <p>&copy;Todos los derechos reservados</p>
    </footer>
</body>
</html>
