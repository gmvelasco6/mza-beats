# Copiá este archivo como .env y cambiá las contraseñas antes de usar Docker Compose.
DB_NAME=mzabeats
DB_USER=mzabeats
DB_PASSWORD=cambiar-esta-clave
DB_ROOT_PASSWORD=cambiar-esta-otra-clave
# Firma las cookies de sesión. Generala con: openssl rand -hex 32
SESSION_SECRET=
# Quién responde por los datos (lo muestra /privacidad)
RESPONSABLE_NOMBRE=
RESPONSABLE_EMAIL=
