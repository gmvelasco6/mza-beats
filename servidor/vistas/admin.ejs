<%# Panel de administración: usuarios, bandas por género y consultas. %><%- include('partes/head') %>
<body>
    <%- include('partes/nav_simple', { textoVolver: 'Volver a Inicio', claseNav: 'nav-admin' }) %>
    <div class="intro">
        <ul class="admin-nav-list">
            <li><a href="#tabla-usuarios">Usuarios</a></li>
            <% for (const [clave, genero] of Object.entries(generos)) { %>
                <li><a href="#tabla-<%= clave %>"><%= genero.nombre %></a></li>
            <% } %>
            <li><a href="#tabla-consultas">Consultas</a></li>
        </ul>
    </div>
    <main class="table-container">
        <%- include('partes/mensajes') %>

        <h1 id="tabla-usuarios" align="center">Usuarios</h1>
        <p align="center">Estados: <% for (const [valor, texto] of estados) { %><%= valor %> = <%= texto %>&nbsp;&nbsp; <% } %></p>
        <table class="table" cellpadding="5">
            <tr>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Estado</th>
                <th>Cantidad Creaciones</th>
                <th>Acción</th>
            </tr>
            <% for (const fila of usuarios) { %>
                <% const formularioUsuario = `form-usuario-${fila.id}`; %>
                <tr align="center">
                    <td><input type="text" value="<%= fila.nombre %>" readonly></td>
                    <td><input type="text" value="<%= fila.usuario %>" readonly></td>
                    <td><input type="text" name="estado" form="<%= formularioUsuario %>" value="<%= fila.estado %>"></td>
                    <td><input type="text" name="cantidad_creaciones" form="<%= formularioUsuario %>" value="<%= fila.cantidad_creaciones %>"></td>
                    <td>
                        <form id="<%= formularioUsuario %>" method="POST">
                            <%- include('partes/csrf') %>
                            <input type="hidden" name="id" value="<%= fila.id %>">
                            <button type="submit" name="accion" value="actualizar-usuario" class="btn-update">Actualizar</button>
                            <button type="submit" name="accion" value="eliminar-usuario" class="btn-delete"
                                data-confirmar="¿Eliminar al usuario <%= fila.usuario %>?">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% } %>
        </table>

        <% for (const [clave, genero] of Object.entries(generos)) { %>
            <h1 id="tabla-<%= clave %>" align="center">Bandas <%= genero.nombre %></h1>
            <table class="table" cellpadding="5">
                <tr>
                    <th>Nombre</th>
                    <th>Descripcion</th>
                    <th>Imagen Principal</th>
                    <th>Imagen Fondo</th>
                    <th>Genero</th>
                    <th>Acción</th>
                </tr>
                <% for (const fila of bandasDeCadaGenero[clave]) { %>
                    <% const formularioBanda = `form-banda-${fila.id}`; %>
                    <tr align="center">
                        <td><input type="text" name="nombre" form="<%= formularioBanda %>" value="<%= fila.nombre %>"></td>
                        <td><textarea name="descripcion" form="<%= formularioBanda %>" class="descripcion"><%= fila.descripcion %></textarea></td>
                        <td><input type="text" name="imagen_principal" form="<%= formularioBanda %>" value="<%= fila.imagen_principal %>"></td>
                        <td><input type="text" name="imagen_fondo" form="<%= formularioBanda %>" value="<%= fila.imagen_fondo %>"></td>
                        <td><input type="text" name="genero" form="<%= formularioBanda %>" value="<%= fila.genero %>"></td>
                        <td>
                            <form id="<%= formularioBanda %>" method="POST">
                                <%- include('partes/csrf') %>
                                <input type="hidden" name="id" value="<%= fila.id %>">
                                <button type="submit" name="accion" value="actualizar-banda" class="btn-update">Actualizar</button>
                                <button type="submit" name="accion" value="eliminar-banda" class="btn-delete"
                                    data-confirmar="¿Eliminar la banda <%= fila.nombre %>?">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </table>
        <% } %>

        <h1 id="tabla-consultas" align="center">Consultas</h1>
        <table class="table" cellpadding="5">
            <tr>
                <th>Nombre</th>
                <th>Razon</th>
                <th>Email</th>
                <th>Acción</th>
            </tr>
            <% for (const fila of consultas) { %>
                <tr align="center">
                    <td><input type="text" value="<%= fila.nombre %>" readonly></td>
                    <td><textarea class="descripcion" readonly><%= fila.razon %></textarea></td>
                    <td><input type="text" value="<%= fila.email %>" readonly></td>
                    <td>
                        <form method="POST">
                            <%- include('partes/csrf') %>
                            <input type="hidden" name="id" value="<%= fila.id %>">
                            <button type="submit" name="accion" value="eliminar-consulta" class="btn-delete"
                                data-confirmar="¿Eliminar esta consulta?">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% } %>
        </table>
    </main>
    <%- include('partes/pie') %>
</body>
</html>
